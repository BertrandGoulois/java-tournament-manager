# Copier ce fichier en .env et remplir chaque valeur AVANT de lancer docker compose.
# Le .env réel est gitignoré et ne doit jamais être commité, ni livré dans une archive.

# Mot de passe Postgres.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Secret de signature JWT. DOIT être encodé en Base64 : JwtService le décode via
# Decoders.BASE64. Une chaîne hexadécimale "fonctionne" par accident (l'alphabet hex est
# un sous-ensemble de l'alphabet Base64) mais fournit environ deux fois moins d'entropie
# que sa longueur ne le laisse croire — c'était le cas de l'ancien secret.
#   openssl rand -base64 64
JWT_SECRET=

# Clé API OpenAI (génération des commentaires de match).
# Sans valeur réelle, le circuit breaker ouvre et l'application reste fonctionnelle.
OPENAI_API_KEY=

# Mot de passe admin Grafana.
#   openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# Mot de passe Redis (buckets de rate limiting).
#   openssl rand -base64 24
REDIS_PASSWORD=

# Mot de passe initial du compte admin de l'application.
# Obligatoire en profil docker : le démarrage échoue s'il est absent (voir
# AdminAccountInitializer). Remplace le hash bcrypt qui était figé dans la migration 003
# et donc identique sur toutes les installations du projet.
ADMIN_INITIAL_PASSWORD=
