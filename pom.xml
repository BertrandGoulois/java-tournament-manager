<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.5</version>
		<relativePath/>
	</parent>
	<groupId>com.tournament</groupId>
	<artifactId>tournament-manager</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<properties>
		<java.version>21</java.version>
		<!--
			Quarantaine ciblée des tests d'intégration instables (§6 de la revue). Vide par
			défaut : tout tourne, et le job CI est bloquant. Un test réellement flaky reçoit
			un @Tag("flaky") et cette propriété passe à "flaky" — ce qui rend la quarantaine
			nominative et visible dans le diff, au lieu du continue-on-error global qui
			désarmait les 9 tests d'intégration d'un coup.
		-->
		<failsafe.excludedGroups></failsafe.excludedGroups>
	</properties>

	<dependencies>
		<!-- Web -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- JPA -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- ShedLock : verrou distribué sur les jobs @Scheduled (voir PurgeScheduler) -->
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-spring</artifactId>
			<version>6.2.0</version>
		</dependency>
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-provider-jdbc-template</artifactId>
			<version>6.2.0</version>
		</dependency>

		<!-- Security -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Validation -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Liquibase -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-liquibase</artifactId>
		</dependency>

		<!-- PostgreSQL -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- JWT -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.3</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.3</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.3</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Swagger -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.6</version>
		</dependency>

		<!-- Redis -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- Kafka -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>

		<!-- WebSocket -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>

		<!-- Gatling -->
		<dependency>
			<groupId>io.gatling.highcharts</groupId>
			<artifactId>gatling-charts-highcharts</artifactId>
			<version>3.13.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.gatling</groupId>
			<artifactId>gatling-app</artifactId>
			<version>3.13.1</version>
			<scope>test</scope>
		</dependency>

		<!-- Bucket4j rate limiting -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j-core</artifactId>
			<version>8.10.1</version>
		</dependency>

		<!-- Bucket4j Redis (rate limiting distribué) -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j-redis</artifactId>
			<version>8.10.1</version>
		</dependency>

		<!-- OpenAI -->
		<dependency>
			<groupId>com.openai</groupId>
			<artifactId>openai-java</artifactId>
			<version>2.4.0</version>
		</dependency>

		<!-- Actuator -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Prometheus -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- Resilience4j -->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-spring-boot4</artifactId>
			<version>2.4.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aspectj</artifactId>
		</dependency>

		<!-- OpenTelemetry -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>

		<!-- Tests -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<!--
				Version explicite malgré le point 29 de la revue (qui recommandait de
				laisser le parent gérer cette version) : la propriété testcontainers.version
				exposée par spring-boot-starter-parent:4.0.5 pointe vers 2.0.4, une version
				qui n'existe pas sur Maven Central. Contradiction assumée entre "suivre la
				lettre de la recommandation" et "avoir un build qui fonctionne" - tranchée
				en faveur du second. À réessayer sans <version> lors d'une future mise à
				jour du parent, si cette propriété est corrigée.
			-->
			<version>1.20.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<version>1.20.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>kafka</artifactId>
			<version>1.20.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.3.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
					<!--
					  Point 2.4 de la revue : spring.profiles.active=local a ete retire de
					  application.properties (il etait cuit dans le jar livre). Le confort de
					  "./mvnw spring-boot:run" est preserve ici, cote outillage de build, ou il
					  ne suit PAS l'artefact deploye.
					-->
					<profiles>
						<profile>local</profile>
					</profiles>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
						<!--
							Pas d'<excludes> ici. Une ancienne version de ce plugin excluait
							domain/model/entities/**, gonflant le pourcentage affiché sans rien
							améliorer réellement (les entités portaient la config du soft delete,
							du versioning et des cascades — pas du code sans intérêt à couvrir).
							Ce package n'existe même plus depuis la séparation domaine/JPA (voir
							le README, section "Architecture hexagonale") : la couverture reflète
							désormais tout le code, y compris infrastructure/output/persistence/entity/.
						-->
					</execution>
				</executions>
			</plugin>

			<!-- Javadoc -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.6.3</version>
				<configuration>
					<source>21</source>
					<doclint>none</doclint>
					<quiet>true</quiet>
					<windowtitle>Tournament Manager API</windowtitle>
					<doctitle>Tournament Manager API</doctitle>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<!--
					Plus d'<excludes> littéraux ici : surefire ignore par défaut tout ce qui
					suit la convention *IT (voir maven-failsafe-plugin ci-dessous), donc les
					9 tests lents/Testcontainers (suffixe IT) ne tournent jamais ici. Avant,
					cette liste d'exclusions était maintenue à la main et s'est déjà
					désynchronisée deux fois en pratique (deux tests d'intégration ajoutés en
					cours de route ont tourné dans le mauvais job faute d'avoir pensé à les y
					ajouter) — la convention de nommage rend cette classe d'erreur impossible.
				-->
				<configuration>
					<environmentVariables>
						<JWT_SECRET>dGVzdC1vbmx5LWR1bW15LWp3dC1zZWNyZXQtbm90LWZvci1wcm9k</JWT_SECRET>
						<ADMIN_INITIAL_PASSWORD>test-only-admin-password</ADMIN_INITIAL_PASSWORD>
					</environmentVariables>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!--
						Ces tests (Testcontainers Postgres/Kafka/Redis, ou contexte Spring
						complet) sont historiquement flaky en CI. Le job qui les exécute était
						pour cette raison marqué continue-on-error dans ci.yml : les 9 tests
						d'intégration — dont la sécurité JSON-RPC, le rate limiting et les
						parcours de tournoi complets — ne bloquaient donc rien du tout, et une
						régression sur JsonRpcSecurityIT serait passée au vert.

						Le job est redevenu bloquant (§6 de la revue). La flakiness est traitée
						là où elle se produit plutôt qu'en désarmant la CI entière :
						  - rerunFailingTestsCount ci-dessous absorbe l'aléa ponctuel ;
						  - un test réellement instable se voit poser @Tag("flaky"), ce qui
						    l'exclut nommément de la CI via excludedGroups, en laissant les 8
						    autres bloquants. Une quarantaine porte alors un nom et se voit
						    dans le diff, au lieu d'être un drapeau global qu'on oublie.

						Pour exécuter aussi les tests en quarantaine :
						  ./mvnw verify -DexcludedGroups=
					-->
					<excludedGroups>${failsafe.excludedGroups}</excludedGroups>
					<rerunFailingTestsCount>2</rerunFailingTestsCount>
					<forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
					<reuseForks>false</reuseForks>
					<!--
						Valeurs de test injectées par le build, jamais commitées comme défaut
						de l'application. Spring Boot les mappe automatiquement vers
						jwt.secret et admin.initial-password (relaxed binding), ce qui évite
						d'injecter le vrai secret de signature dans un runner CI.

						ADMIN_INITIAL_PASSWORD est indispensable : la migration 003 crée le
						compte admin avec un hash bcrypt public, et AdminAccountInitializer
						fait volontairement échouer le démarrage tant que ce hash est là sans
						mot de passe fourni.

						POSTGRES_PASSWORD est de toute façon écrasé au runtime par
						Testcontainers (@ServiceConnection) ; OPENAI_API_KEY n'a besoin que
						d'être syntaxiquement présent pour que le bean OpenAiConfig se
						construise (le circuit breaker mocke l'appel réel).
					-->
					<environmentVariables>
						<JWT_SECRET>dGVzdC1vbmx5LWR1bW15LWp3dC1zZWNyZXQtbm90LWZvci1wcm9k</JWT_SECRET>
						<POSTGRES_PASSWORD>test-only-unused-password</POSTGRES_PASSWORD>
						<OPENAI_API_KEY>test-only-dummy-key-not-real</OPENAI_API_KEY>
						<ADMIN_INITIAL_PASSWORD>test-only-admin-password</ADMIN_INITIAL_PASSWORD>
					</environmentVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>io.gatling</groupId>
				<artifactId>gatling-maven-plugin</artifactId>
				<version>4.9.2</version>
				<configuration>
					<simulationClass>simulations.TournamentSimulation</simulationClass>
					<jvmArgs>
						<jvmArg>--add-opens=java.base/java.lang=ALL-UNNAMED</jvmArg>
						<jvmArg>--add-opens=java.base/java.util=ALL-UNNAMED</jvmArg>
					</jvmArgs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>1.18.2</version>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>1.2.3</version>
					</dependency>
				</dependencies>
				<configuration>
					<targetClasses>
						<param>com.tournament.tournament_manager.application.*</param>
					</targetClasses>
					<targetTests>
						<param>com.tournament.tournament_manager.application.*</param>
					</targetTests>
					<!--
						§7 de la revue : application.shared.* était exclu du mutation testing.
						C'est précisément le package qui contient BracketUtils et
						RoundRobinUtils — le seeding de bracket et la méthode du cercle, soit
						l'arithmétique la plus dense et la plus mutable du projet, celle où un
						off-by-one passe le plus facilement au travers d'une assertion trop
						large. L'exclusion visait exactement l'inverse de sa cible utile ; elle
						est levée.

						Aucune classe n'est exclue aujourd'hui. Si le rapport PIT devient trop
						long à produire, réduire plutôt le périmètre par targetClasses que par
						excludedClasses, pour que le retrait reste lisible.
					-->
					<mutators>
						<mutator>DEFAULTS</mutator>
					</mutators>
					<outputFormats>
						<outputFormat>HTML</outputFormat>
					</outputFormats>
					<timestampedReports>false</timestampedReports>
				</configuration>
			</plugin>

			<!--
				§6 de la revue : aucun outil de mise en forme n'existait, d'ou les fins de
				ligne melangees CRLF/LF fichier par fichier (53 CRLF pour 147 LF sur un
				echantillon de 200 sources).

				Configuration DELIBEREMENT minimaliste : pas de formateur global type
				google-java-format ou palantir. Un reformatage complet reecrirait les ~250
				fichiers du projet et noierait toute revue future sous du bruit d'indentation.
				Ici, seulement de l'hygiene : imports inutilises, espaces en fin de ligne,
				retour a la ligne final, fins de ligne normalisees en LF.

				Volontairement NON lie a une phase du build. `mvn verify` ne le declenche pas.
				Deux raisons : ne pas casser le build de quelqu'un qui n'a pas encore lance
				spotless:apply, et surtout garder le reformatage dans un commit SEPARE des
				changements fonctionnels - un diff melant logique et mise en forme est
				irrevisable.

				  ./mvnw spotless:check    verifie sans modifier
				  ./mvnw spotless:apply    corrige
			-->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>2.44.0</version>
				<configuration>
					<java>
						<removeUnusedImports/>
						<trimTrailingWhitespace/>
						<endWithNewline/>
						<importOrder>
							<order>java,javax,jakarta,org,com,</order>
						</importOrder>
					</java>
					<pom>
						<sortPom>
							<expandEmptyElements>false</expandEmptyElements>
						</sortPom>
					</pom>
					<formats>
						<format>
							<includes>
								<include>src/main/resources/**/*.properties</include>
								<include>src/main/resources/**/*.sql</include>
								<include>*.yml</include>
								<include>docker/**/*.yml</include>
								<include>.github/**/*.yml</include>
							</includes>
							<trimTrailingWhitespace/>
							<endWithNewline/>
						</format>
					</formats>
					<!--
						LF partout, en accord avec le `* text=auto eol=lf` de .gitattributes.
						Les deux doivent rester coherents, sinon chaque developpeur reecrit
						les fins de ligne de l'autre a chaque commit.
					-->
					<lineEndings>UNIX</lineEndings>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<!--
									Bloque exactement le genre de doublon qu'on vient de retirer
									(spring-boot-starter-test-classic + spring-boot-starter-test) :
									deux versions différentes de la même dépendance transitive dans
									l'arbre est presque toujours un signe d'oubli, jamais volontaire.
								-->
								<!--
									dependencyConvergence retiree apres un premier essai : elle
									revele deux conflits transitifs preexistants et sans rapport
									avec ce qu'on vient de corriger (okio via openai-java vs
									opentelemetry, commons-text via deux chemins de liquibase-core)
									- probablement inoffensifs, mais les resoudre proprement
									demanderait des exclusions ciblees a chaque nouvelle dependance
									ajoutee. Cout de maintenance juge disproportionne pour ce projet
									a ce stade ; a reconsiderer si le nombre de dependances tierces
									grossit significativement.
								-->
								<requireJavaVersion>
									<version>[21,)</version>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
				Point 29 de la revue : pas de Checkstyle, Spotless ou SpotBugs pour l'instant.
				Les ajouter correctement (choix des règles, correction de l'existant pour
				passer sans erreur dès le premier run) est un chantier à part entière -
				décision volontairement différée, pas oubliée.
			-->
		</plugins>
	</build>

</project>
